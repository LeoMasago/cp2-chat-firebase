rules_version = '2';

// Regras do Cloud Firestore.
//
// Responsabilidade deste banco: perfis, grupos (metadados, integrantes, limite,
// política de notificações), conversas individuais e tokens de dispositivos.
// As mensagens ficam no Realtime Database (database.rules.json).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ------------------------------------------------------------------
    // Perfis
    //   users/{uid}                  -> dados públicos (nome e foto): listagem e busca
    //   users/{uid}/private/profile  -> e-mail, celular e nascimento: só o dono lê.
    //                                   Outros usuários os recebem pela API, que confere
    //                                   se há conversa individual ou grupo em comum.
    //   users/{uid}/devices/{id}     -> tokens de push: só o dono lê/escreve.
    // ------------------------------------------------------------------
    function validPublicProfile(data) {
      return data.keys().hasOnly(['name', 'nameLower', 'photoUrl', 'createdAt'])
        && data.keys().hasAll(['name', 'nameLower', 'photoUrl', 'createdAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.nameLower is string && data.nameLower.size() <= 80
        && data.photoUrl is string && data.photoUrl.size() <= 2048
        && data.createdAt is number;
    }

    function validPrivateProfile(data) {
      return data.keys().hasOnly(['email', 'phoneNumber', 'birthDate'])
        && data.keys().hasAll(['email', 'phoneNumber', 'birthDate'])
        && data.email is string
        && request.auth.token.email != null
        && data.email.lower() == request.auth.token.email.lower()
        && data.phoneNumber is string && data.phoneNumber.size() >= 8 && data.phoneNumber.size() <= 20
        && data.birthDate is string && data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validDevice(data) {
      return data.keys().hasOnly(['token', 'tokenType', 'platform', 'enabled', 'updatedAt'])
        && data.keys().hasAll(['token', 'tokenType', 'platform', 'enabled', 'updatedAt'])
        && data.token is string && data.token.size() >= 20 && data.token.size() <= 4096
        && data.tokenType in ['fcm', 'expo']
        && data.platform in ['android', 'ios']
        && data.enabled is bool
        && data.updatedAt is number;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid) && validPublicProfile(request.resource.data);
      allow update: if isSelf(uid)
        && validPublicProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /private/{docId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && docId == 'profile'
          && validPrivateProfile(request.resource.data);
        allow delete: if false;
      }

      match /devices/{deviceId} {
        allow read, delete: if isSelf(uid);
        allow create, update: if isSelf(uid) && validDevice(request.resource.data);
      }
    }

    // ------------------------------------------------------------------
    // Grupos
    //   - só integrantes leem;
    //   - só o proprietário cria/altera (nome, foto, integrantes, limite, política);
    //   - o limite é verificado SOBRE O DOCUMENTO RESULTANTE de cada escrita:
    //     memberIds.size() <= memberLimit. Como o Firestore avalia a regra de forma
    //     atômica no commit, duas entradas simultâneas nunca ultrapassam o limite
    //     (a segunda escrita é recusada) e o limite nunca fica abaixo da quantidade
    //     atual de integrantes.
    // ------------------------------------------------------------------
    function validGroup(g) {
      return g.keys().hasOnly(['name', 'photoUrl', 'ownerId', 'memberIds', 'memberLimit',
                               'notificationPolicy', 'createdAt', 'updatedAt'])
        && g.keys().hasAll(['name', 'photoUrl', 'ownerId', 'memberIds', 'memberLimit',
                            'notificationPolicy', 'createdAt', 'updatedAt'])
        && g.name is string && g.name.size() >= 3 && g.name.size() <= 60
        && g.photoUrl is string && g.photoUrl.size() <= 2048
        && g.ownerId is string
        && g.memberIds is list
        && g.memberIds.size() >= 2
        && g.memberIds.toSet().size() == g.memberIds.size()
        && g.ownerId in g.memberIds
        && g.memberLimit is int && g.memberLimit >= 2 && g.memberLimit <= 50
        && g.memberIds.size() <= g.memberLimit
        && g.notificationPolicy in ['all_group_messages', 'mentioned_members',
                                    'direct_messages_only', 'disabled']
        && g.createdAt is number
        && g.updatedAt is number;
    }

    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && groupId.matches('^[A-Za-z0-9]{20}$')
        && request.resource.data.ownerId == request.auth.uid
        && validGroup(request.resource.data);

      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && validGroup(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // Conversas individuais: id = uid menor + '_' + uid maior, o que impede duas
    // conversas diferentes para o mesmo par e conversa consigo mesmo.
    // ------------------------------------------------------------------
    match /directConversations/{conversationId} {
      allow get: if signedIn()
        && (conversationId.matches(request.auth.uid + '_.*')
            || conversationId.matches('.*_' + request.auth.uid));

      allow list: if signedIn() && request.auth.uid in resource.data.participantIds;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['participantIds', 'createdAt'])
        && request.resource.data.keys().hasAll(['participantIds', 'createdAt'])
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantIds[0] is string
        && request.resource.data.participantIds[1] is string
        && request.resource.data.participantIds[0] < request.resource.data.participantIds[1]
        && conversationId == request.resource.data.participantIds[0] + '_'
                             + request.resource.data.participantIds[1]
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.createdAt is number;

      allow update, delete: if false;
    }

    // Controle de idempotência do push: somente a API (Admin SDK ignora as regras).
    match /notificationDispatches/{dispatchId} {
      allow read, write: if false;
    }

    // Tudo o que não foi liberado acima é negado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
