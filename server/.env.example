# ---------------------------------------------------------------------------
# API de notificações — variáveis de ambiente
#
# NUNCA coloque valores reais aqui nem em qualquer arquivo versionado.
# Os valores reais ficam SOMENTE nas variáveis secretas da hospedagem
# (Render, Cloud Run, Railway, Fly.io...). Para rodar localmente, copie este
# arquivo para `.env` (ignorado pelo Git) e carregue-o com `node --env-file=.env`.
# ---------------------------------------------------------------------------

# Porta HTTP (a hospedagem normalmente define sozinha)
PORT=3000

# Conta de serviço do Firebase (Console > Configurações do projeto > Contas de serviço)
FIREBASE_PROJECT_ID=seu-project-id
FIREBASE_CLIENT_EMAIL=email-da-conta-de-servico
FIREBASE_PRIVATE_KEY=CONFIGURAR_APENAS_NA_HOSPEDAGEM
FIREBASE_DATABASE_URL=https://seu-project-id-default-rtdb.firebaseio.com

# Opcional: token de acesso do Expo Push Service (só se "Enhanced Security" estiver ativo)
EXPO_ACCESS_TOKEN=

# true = o push inclui um trecho (80 caracteres) do texto; false = "X enviou uma mensagem."
NOTIFICATION_PREVIEW=true

# Quantidade de proxies na frente da API (Render/Cloud Run/Railway = 1)
TRUST_PROXY=1
