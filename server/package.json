{
  "name": "cp2-chat-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API de notificações push e operações seguras do app de chat (Firebase Admin SDK).",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "dev:emulator": "tsx src/dev/emulatorServer.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "expo-server-sdk": "^7.2.0",
    "express": "^5.2.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "vitest": "^5.0.3"
  }
}
