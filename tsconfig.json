{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "App.tsx",
    "index.ts",
    "src/**/*",
    "*.config.*"
  ],
  "exclude": [
    "node_modules",
    "server",
    "android",
    "ios",
    "dist",
    "scripts"
  ]
}
